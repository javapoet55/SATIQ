{
  "name": "preporbit-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node --experimental-strip-types server/index.mjs",
    "build": "tsc -b && vite build && vite build --config vite.landing.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/intelligence.test.ts tests/model.test.ts tests/companion.test.ts tests/server.test.mjs tests/assistant.test.mjs tests/math-tools.test.mjs tests/topic-tests.test.ts tests/bank.test.mjs tests/ai.test.mjs",
    "test:e2e": "playwright test",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "mathjs": "^14.9.1",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
